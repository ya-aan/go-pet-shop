# Настройки PostgreSQL
POSTGRES_USER=postgres # Имя пользователя базы данных
POSTGRES_PASSWORD=pass  # Секрет!
POSTGRES_DB=postgres # Имя базы данных
DB_HOST=localhost # Хост базы данных (для запуска приложения и миграций с хоста)
DB_PORT=5432  # Порт PostgreSQL на хосте (docker compose пробрасывает сюда порт контейнера)

# URL для подключения с хоста (использует переменные выше).
# В docker compose контейнер app получает свой DATABASE_URL с хостом postgres, см. docker-compose.yml
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}?sslmode=disable

# Отдельная база для интеграционных тестов (task test-integration), по умолчанию выключено.
# Тесты откажутся запускаться, если в имени базы нет "test" или она совпадает с DATABASE_URL.
# Создать базу: docker compose exec postgres createdb -U postgres petshop_test
# TEST_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${DB_PORT}/petshop_test?sslmode=disable
